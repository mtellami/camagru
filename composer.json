{
  "name": "mtellami/camagru",
  "description": "Development tools for the Camagru PHP application",
  "type": "project",
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.30"
  },
  "scripts": {
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
